package components

import "zoie/config"

templ Donate(cfg *config.Config) {
	<section
		id="donate"
		class="bg-green-900 reveal"
		_="on intersection(intersecting) if intersecting add .reveal-active to me"
	>
		<div class="max-w-3xl mx-auto px-5 py-20 md:py-28">
			<div class="text-center">
				<span class="text-sm font-bold uppercase tracking-wide text-orange-300">Give Today</span>
				<h2 class="mt-3 text-3xl md:text-5xl font-extrabold text-white tracking-tight">Support Feed The Street</h2>
				<p class="mt-4 text-green-50/80">Every contribution — big or small — turns directly into meals.</p>
			</div>

			<div class="mt-10 rounded-2xl bg-white p-6 md:p-8 shadow-2xl">
				<!-- Payment method tabs -->
				<div class="flex rounded-full bg-gray-100 p-1 text-sm font-semibold">
					<button
						type="button"
						id="tab-card"
						class="flex-1 rounded-full py-2.5 transition bg-white shadow text-green-700"
						_="on click
							add .bg-white to me then add .shadow to me then add .text-green-700 to me then remove .text-gray-500 from me then
							remove .bg-white from #tab-bank then remove .shadow from #tab-bank then remove .text-green-700 from #tab-bank then add .text-gray-500 to #tab-bank then
							remove .hidden from #card-panel then add .hidden to #bank-panel"
					>
						Pay Online
					</button>
					<button
						type="button"
						id="tab-bank"
						class="flex-1 rounded-full py-2.5 transition text-gray-500"
						_="on click
							add .bg-white to me then add .shadow to me then add .text-green-700 to me then remove .text-gray-500 from me then
							remove .bg-white from #tab-card then remove .shadow from #tab-card then remove .text-green-700 from #tab-card then add .text-gray-500 to #tab-card then
							remove .hidden from #bank-panel then add .hidden to #card-panel"
					>
						Bank Transfer
					</button>
				</div>

				<!-- ONLINE (Paystack) PATH -->
				<div id="card-panel" class="mt-8">
					<form id="donate-form" hx-post="/donate/initiate" hx-target="#donate-error" hx-swap="innerHTML">
						<label class="text-sm font-semibold text-gray-700">Choose an amount (NGN)</label>
						<div class="mt-3 grid grid-cols-4 gap-2">
							for _, preset := range []int{5000, 10000, 25000, 50000} {
								<button
									type="button"
									class="amount-preset rounded-lg border py-2.5 px-2 text-sm transition bg-white text-gray-700 border-gray-200"
									data-amount={ itoaLiteral(preset) }
									_={ "on click set #amount-input.value to my @data-amount then set #amount-display.innerHTML to '₦" + formatThousands(preset) + "' then remove .bg-orange-600 from .amount-preset then remove .text-white from .amount-preset then remove .border-orange-600 from .amount-preset then add .bg-white to .amount-preset then add .text-gray-700 to .amount-preset then add .border-gray-200 to .amount-preset then remove .bg-white from me then remove .text-gray-700 from me then remove .border-gray-200 from me then add .bg-orange-600 to me then add .text-white to me then add .border-orange-600 to me" }
								>
									₦{ formatThousands(preset) }
								</button>
							}
						</div>

						<div class="mt-3">
							<label class="text-xs font-medium text-gray-500">Or enter a custom amount</label>
							<div class="mt-1 relative">
								<span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400">₦</span>
								<input
									type="number"
									id="amount-input"
									name="amount"
									min="100"
									value="10000"
									class="w-full rounded-lg border border-gray-200 pl-7 pr-3 py-2.5 text-sm focus:border-orange-600 focus:ring-1 focus:ring-orange-600 outline-none"
									placeholder="10000"
									_="on input set #amount-display.innerHTML to '₦' + my value then remove .bg-orange-600 from .amount-preset then remove .text-white from .amount-preset then remove .border-orange-600 from .amount-preset then add .bg-white to .amount-preset then add .text-gray-700 to .amount-preset then add .border-gray-200 to .amount-preset"
								/>
							</div>
						</div>

						<div class="mt-5 grid sm:grid-cols-2 gap-4">
							<div>
								<label class="text-xs font-medium text-gray-500">Full name</label>
								<input
									type="text"
									name="name"
									required
									class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:border-orange-600 focus:ring-1 focus:ring-orange-600 outline-none"
									placeholder="Jane Doe"
								/>
							</div>
							<div>
								<label class="text-xs font-medium text-gray-500">Email</label>
								<input
									type="email"
									name="email"
									required
									class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:border-orange-600 focus:ring-1 focus:ring-orange-600 outline-none"
									placeholder="jane@example.com"
								/>
							</div>
						</div>

						<div class="mt-4">
							<label class="text-xs font-medium text-gray-500">Leave a message (optional)</label>
							<textarea
								name="message"
								rows="2"
								class="mt-1 w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm focus:border-orange-600 focus:ring-1 focus:ring-orange-600 outline-none"
								placeholder="A word of encouragement..."
							></textarea>
						</div>

						<label class="mt-3 flex items-center gap-2 text-xs text-gray-500">
							<input type="checkbox" name="anonymous" value="true" class="rounded border-gray-300"/>
							Give anonymously
						</label>

						<div id="donate-error" class="mt-4"></div>

						<button
							type="submit"
							hx-disabled-elt="this"
							class="mt-6 w-full rounded-full bg-orange-600 py-3.5 text-base font-bold text-white shadow-lg hover:bg-orange-700 transition disabled:opacity-60"
						>
							<span class="donate-label">Donate <span id="amount-display">₦10,000</span> via Paystack</span>
							<span class="htmx-indicator">Redirecting to secure checkout…</span>
						</button>

						<p class="mt-3 text-center text-xs text-gray-400">Payments are processed securely by Paystack. We never see your card details.</p>
					</form>
				</div>

				<!-- BANK TRANSFER PATH -->
				<div id="bank-panel" class="mt-8 hidden space-y-4">
					if cfg.BankAccountNumber != "" {
						@bankCard(cfg.BankName, cfg.BankAccountName, cfg.BankAccountNumber)
					}
					if cfg.BankAccountNumber2 != "" {
						@bankCard(cfg.BankName2, cfg.BankAccountName2, cfg.BankAccountNumber2)
					}
					<p class="text-xs text-gray-500">
						After transferring, please send your receipt to us so we can confirm and say thank you —
						details are on the Contact section in the footer.
					</p>
				</div>
			</div>
		</div>
	</section>
}

templ bankCard(bankName, accountName, accountNumber string) {
	<div class="rounded-xl border border-gray-200 p-5">
		<div class="flex flex-col gap-3 text-sm">
			<div>
				<div class="text-xs text-gray-400">Bank</div>
				<div class="font-semibold text-gray-800">{ bankName }</div>
			</div>
			<div>
				<div class="text-xs text-gray-400">Account Name</div>
				<div class="font-semibold text-gray-800">{ accountName }</div>
			</div>
			<div>
				<div class="text-xs text-gray-400">Account Number</div>
				<div class="flex items-center gap-2">
					<span class="font-semibold text-gray-800">{ accountNumber }</span>
					<button
						type="button"
						class="text-xs font-semibold text-orange-600 hover:underline"
						_={ "on click call navigator.clipboard.writeText('" + accountNumber + "') then put 'Copied!' into me then wait 1500ms then put 'Copy' into me" }
					>
						Copy
					</button>
				</div>
			</div>
		</div>
	</div>
}