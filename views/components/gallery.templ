package components

import "zoie/views/data"

func imageURL(base, path string) string {
	return path
}

templ Gallery(imageBaseURL string) {
	<section
		id="gallery"
		class="max-w-6xl mx-auto px-5 py-20 md:py-28 reveal"
		_="on intersection(intersecting) if intersecting add .reveal-active to me"
	>
		<div class="max-w-2xl">
			<span class="text-sm font-bold uppercase tracking-wide text-orange-600">Moments From The Field</span>
			<h2 class="mt-3 text-3xl md:text-5xl font-extrabold text-gray-900 tracking-tight">Gallery</h2>
			<p class="mt-4 text-gray-600">Photos from Feed The Street across the communities we've served.</p>
		</div>

		<div class="mt-10 grid grid-cols-2 md:grid-cols-3 gap-3">
			for _, img := range data.Gallery {
				<button
					type="button"
					class="group relative aspect-square overflow-hidden rounded-xl bg-gray-100"
					data-full={ imageURL(imageBaseURL, img.Path) }
					data-alt={ img.Alt }
					_="on click
						set #lightbox-img.src to my @data-full then
						set #lightbox-img.alt to my @data-alt then
						set #lightbox's *display to 'flex'"
				>
					<img
						src={ imageURL(imageBaseURL, img.Path) }
						alt={ img.Alt }
						loading="lazy"
						class="w-full h-full object-cover transition duration-300 group-hover:scale-105"
					/>
					<span class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent text-white text-xs font-medium px-3 py-2 text-left">
						{ img.Location } · { img.Year }
					</span>
				</button>
			}
		</div>

		<div
			id="lightbox"
			style="display:none"
			class="fixed inset-0 z-[100] items-center justify-center bg-black/85 p-6"
			_="on click set my *display to 'none'"
		>
			<button
				type="button"
				class="absolute top-6 right-6 text-white/80 hover:text-white text-3xl leading-none"
				aria-label="Close"
				_="on click set #lightbox's *display to 'none'"
			>
				&times;
			</button>
			<img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-lg object-contain" _="on click halt the event"/>
		</div>
	</section>
}