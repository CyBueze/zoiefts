package layout

templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } | Zoie Foundation</title>
			<meta name="description" content="Zoie Foundation — feeding communities across Nigeria for 7 years through the annual Feed The Street initiative. Donate today."/>

			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>

			<!-- Tailwind v4 browser build — prototyping only, swap for a real build before production -->
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

			<!-- htmx -->
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js"
				integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
				crossorigin="anonymous"></script>

			<!-- Hyperscript -->
			<script src="https://cdn.jsdelivr.net/npm/hyperscript.org@0.9.93/dist/_hyperscript.min.js"
				integrity="sha384-/6HsqTiz02YfFBUhzTwlH/yxe68DhfnkdHiWytM3nxAzs/yvG+3FZY0f4KLnNoov"
				crossorigin="anonymous"></script>

			<style>
				html { scroll-behavior: smooth; }
				body { font-family: 'Montserrat', sans-serif; }

				/* nav: transparent over the hero, solid once scrolled */
				.nav-scrolled {
					background-color: rgba(6, 24, 14, 0.92);
					backdrop-filter: blur(12px);
					box-shadow: 0 4px 20px rgba(0,0,0,0.15);
				}

				/* scroll-reveal, driven by hyperscript's intersection event below */
				.reveal {
					opacity: 0;
					transform: translateY(40px);
					transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1);
				}
				.reveal-active {
					opacity: 1;
					transform: none;
				}

				/* htmx request state — swap the donate button's label for a spinner line */
				.htmx-indicator { display: none; }
				.htmx-request .htmx-indicator { display: inline; }
				.htmx-request .donate-label { display: none; }
			</style>
		</head>
		<body class="bg-white text-gray-900 antialiased">
			{ children... }
		</body>
	</html>
}