package components

import "zoie/views/data"

templ Hero() {
	<section id="top" class="relative overflow-hidden rounded-b-[2.5rem] shadow-xl min-h-[640px] flex items-end">
		<div
			class="absolute inset-0 bg-cover bg-center"
			style="background-image: linear-gradient(180deg, rgba(6,24,14,0.35) 0%, rgba(6,24,14,0.9) 100%), url('https://59doenkwa7.ufs.sh/f/jhH9iucglD1pJkcVvdom5df6iCXqPkTtMavYRLnlWDHhsVAj');"
		></div>

		<div
			class="relative z-10 max-w-6xl mx-auto px-5 pt-32 pb-20 md:pb-28 text-center w-full reveal"
			_="init wait 100ms then add .reveal-active to me"
		>
			<span class="inline-block rounded-full bg-orange-600/90 text-white text-xs font-bold tracking-wide uppercase px-4 py-1.5">
				{ data.YearsActive } Years of { data.FlagshipEvent }
			</span>

			<h1 class="mt-6 text-4xl md:text-6xl font-extrabold text-white leading-[0.98] tracking-tight">
				Every meal we serve is <br class="hidden md:block"/>
				<span class="text-orange-400">a promise kept.</span>
			</h1>

			<p class="mt-6 max-w-2xl mx-auto text-lg text-white/80">
				{ data.OrgName } has spent { data.YearsActive } years feeding communities across Nigeria —
				from Koka to Lagos — through our annual { data.FlagshipEvent } initiative.
				Your donation puts a warm meal directly in someone's hands.
			</p>

			<div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
				<a
					href="#donate"
					class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-orange-600 px-8 py-3.5 text-base font-semibold text-white shadow-lg hover:bg-orange-700 hover:-translate-y-0.5 transition"
				>
					Donate Now
				</a>
				<a
					href="#about"
					class="w-full sm:w-auto inline-flex items-center justify-center rounded-full bg-white/10 border border-white/30 px-8 py-3.5 text-base font-semibold text-white hover:bg-white/20 transition"
				>
					Learn Our Story
				</a>
			</div>
		</div>
	</section>
}